{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SKYJO-DS",
            "type": "shell",
            "command": "./make.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Build SKYJO-DS debug",
            "type": "shell",
            "command": "./make_debug.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean SKYJO-DS",
            "type": "shell",
            "command": "./clean.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean SKYJO-DS debug",
            "type": "shell",
            "command": "./clean_debug.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Rebuild SKYJO-DS",
            "dependsOrder": "sequence",
            "dependsOn": ["Clean SKYJO-DS", "Build SKYJO-DS"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Rebuild SKYJO-DS debug",
            "dependsOrder": "sequence",
            "dependsOn": ["Clean SKYJO-DS debug", "Build SKYJO-DS debug"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Generate compile_commands.json",
            "type": "shell",
            "command": "./make.sh",
            "args": ["--compdb"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Setup Python env (architectds modification)",
            "type": "shell",
            "command": "./setup-env.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Run in melonDS",
            "type": "shell",
            "command": "../melonDS",
            "args": ["skyjo-nds.nds"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Generate hexButtons",
            "type": "shell",
            "command": "cd ./resources/MainMenu && ./buttonBash.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Build & Run SKYJO-DS",
            "dependsOrder": "sequence",
            "dependsOn": ["Build SKYJO-DS", "Run in melonDS"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build & Run SKYJO-DS debug",
            "dependsOrder": "sequence",
            "dependsOn": ["Build SKYJO-DS debug", "Run in melonDS"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Rebuild & Run SKYJO-DS",
            "dependsOrder": "sequence",
            "dependsOn": ["Rebuild SKYJO-DS", "Run in melonDS"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Rebuild & Run SKYJO-DS debug",
            "dependsOrder": "sequence",
            "dependsOn": ["Rebuild SKYJO-DS debug", "Run in melonDS"],
